EXTENSION "vtm5e-fixture-layer" EXTENDS "vtm5e" {
    NAME "The layer build's own fixture"
    VERSION "0.1.0"
    SPEC_VERSION "0.5"
    RELEASE_DATE "2026-09-23"

    # Not game content. The smallest layer that exercises every path of build/build_layer.py:
    # a Storyteller character and a Discipline power found by the corpus's own shapes (the
    # records path, including a power's Discipline and Level), an EXTENDS by hash on the BASE's
    # Table (the references gate), and a MODIFY on a corpus entity named without a hash (the
    # names gate). Built only to a scratch folder by the layer's tests, never into data/.

    MODIFY ^"Hunger" {
        GUIDANCE {
            ENTRY ^"fixture-guidance" #FXLayerFixtureGuide01 {
                TOPICS [ "fixture" ]
                TEXT "A fixture guidance entry, not a rule."
            }
        }
    }

    #FXLayerFixtureChar0001 ^"Fixture Adversary" DEF {
        DESCRIPTION "A fixture for the layer build, not a character."
        ^"Standard Dice Pools" STRING "Physical 3, Social 2, Mental 4"
        ^"Secondary Attributes" STRING "Health 6, Willpower 5"
        ^"Clan" STRING "Nosferatu"
    }

    #FXLayerFixtureDisc0001 ^"Animalism" DEF {
        DESCRIPTION "A fixture heading, so a power below it takes a Discipline."
        #FXLayerFixtureLevel01 ^"Level 1" DEF {
            DESCRIPTION "A fixture heading, so a power below it takes a Level."
            #FXLayerFixturePower01 ^"Fixture Whisper" DEF {
                DESCRIPTION "A fixture for the layer build, not a power."
                ^"Cost" STRING "One Rouse Check."
                ^"System" STRING "A fixture system line, not a rule."
            }
        }
    }

    #FXLayerFixtureTable001 ^"Fixture Table" DEF {
        EXTENDS #vtm5Table000000000001 ^"Table"
        TABLE {
            COLUMNS ["Column", "Other column"]
            ROW ["A cell", "Another cell"]
        }
    }
}
