EXTENSION "VTM5e_WarOfPrinces_Roads" {
    NAME "War of Princes — The Road System (Dark Ages morality, used in place of Humanity)"
    VERSION "1.0"
    SPEC_VERSION "0.4"
    RELEASE_DATE "2026-06-22"
    DEPENDS_ON "VTM5e_Core_Core" VERSION "0.4"

    # Campaign homebrew for the War of Princes chronicle (London, 1242). A Cainite
    # follows a ROAD rather than clinging to Humanity. The Road rating behaves like
    # the V5 Humanity track (0..10) — higher ratings give more dice to resist Frenzy,
    # low ratings impose penalties reflecting the Beast's influence, and the rating
    # falls through Degeneration. This file replaces ^"Humanity" for these characters.

    # ---- the Road morality track (the type each specific Road extends) ----
    #wopRoadTrack000001 ^"Road" DEF {
        APPLIES TO [^"Kindred"]

        INTEGER MIN 0 MAX 10

        DESCRIPTION "The Dark Ages morality track, used in place of Humanity for this chronicle. A character records which Road they walk and their current Road rating (starting at 7). Each Road has a hierarchy of sins; the rating sets which level of sin the character recognizes (that rating and every sin below it). Higher ratings are stricter and harder to hold; lower ratings are more permissive and require more severe sins to fall further."

        DERIVED_PROPERTIES {
            ^"Road Name" STRING
            ^"Aura" STRING
        }

        RULES {
            #wopRoadRuleFrenzy1: higher_road_rating_grants_more_dice_to_resist_frenzy
            #wopRoadRuleDegen01: committing_a_recognized_sin_causes_stains
            #wopRoadRuleRemors1: unresolved_stains_force_a_remorse_roll_at_end_of_session
            #wopRoadRuleFall001: failing_the_remorse_roll_lowers_the_road_rating_by_one
            #wopRoadRuleRaise01: raising_the_road_rating_requires_great_commitment_or_sudden_growth
            #wopRoadRulePenal01: low_ratings_impose_escalating_social_interaction_penalties
            #wopRoadRuleAura001: aura_is_projected_with_a_rouse_check_and_lasts_one_scene
        }
    }

    # ---- shared Road concepts ----
    #wopRoadDegen000001 ^"Road Degeneration" DEF {
        DESCRIPTION "Committing a sin the character recognizes (at or below their current Road rating) causes Stains. Unresolved Stains require a Remorse roll at the end of a session to resolve; failing the Remorse roll decreases the Road rating by one. Raising a Road rating requires a great commitment of time and effort, or rare moments of profound sudden growth."
    }

    #wopRoadAura0000001 ^"Road Aura" DEF {
        DESCRIPTION "An Aura is the feeling or impression a Cainite projects associated with their Road, making them appear more in line with their Road than their Beast and often disguising their vampiric nature. A character projects their Aura with a Rouse check; it lasts one scene. The mechanical effect differs by Road (see each Road's hierarchy). At high ratings some Auras become permanent."
        PROPERTIES {
            ^"Beast Aura" STRING "Predator's Instinct"
            ^"Humanity Aura" STRING "Blush of Life"
            ^"Heaven Aura" STRING "Holy Radiance"
            ^"Kings Aura" STRING "Air of Authority"
        }
    }

    # ============================================================
    #  Road of the Beast (Ferals) — Via Bestiae
    # ============================================================
    #wopRoadBeast000001 ^"Road of the Beast" DEF {
        EXTENDS ^"Road"
        PROPERTIES {
            ^"Latin Name" STRING "Via Bestiae"
            ^"Followers" STRING "Ferals"
            ^"Aura" STRING "Predator's Instinct"
            ^"Tenets" LIST OF STRING [
                "Exist in accord with the needs of the Beast",
                "Do what you must to survive. No more, no less.",
                "Mercy is for the weak. Only the strong survive.",
                "The past is dead, the future is unborn. The moment is yours.",
                "Respect only the strong"
            ]
            ^"Hierarchy of Sins" DEF {
                ^"Rating 10" DEF { ^"Moral Guideline" STRING "Taking foolhardy risks" ^"Rationale" STRING "Survival is paramount" ^"Effects" LIST OF STRING ["Permanently have the effects of Aura; appear as a living creature to beasts", "Heal Superficial damage as a mortal", "You can taste, eat, and digest food that you hunt", "Healing Aggravated damage during day sleep requires one Rouse check"] }
                ^"Rating 9" DEF { ^"Moral Guideline" STRING "Leaving the weak unchallenged" ^"Rationale" STRING "Only the strongest should lead" ^"Effects" LIST OF STRING ["Permanently have the effects of Aura; appear as an ill creature", "Heal Superficial damage as a mortal", "Healing Aggravated damage during day sleep requires two Rouse checks"] }
                ^"Rating 8" DEF { ^"Moral Guideline" STRING "Killing without need" ^"Rationale" STRING "Murder is a creation of society" ^"Effects" LIST OF STRING ["Roll two dice for the Aura Rouse check and take the highest result"] }
                ^"Rating 7" DEF { ^"Moral Guideline" STRING "Avoiding the wilds" ^"Rationale" STRING "In nature lies strength; civilization is soft and weak" ^"Effects" LIST OF STRING ["Using Aura negates penalties from drinking animal blood", "With no penalties from animal blood, you can sate one additional Hunger than usual from an animal regardless of size"] }
                ^"Rating 6" DEF { ^"Moral Guideline" STRING "Tormenting others needlessly" ^"Rationale" STRING "Only civilized folk engage in these things" ^"Effects" LIST OF STRING ["With Aura, penalties from drinking animal blood are treated as one Blood Potency level lower"] }
                ^"Rating 5" DEF { ^"Moral Guideline" STRING "Making unbidden sacrifice" ^"Rationale" STRING "You owe others nothing" ^"Effects" LIST OF STRING ["You suffer a one-die penalty to interact with non-hostiles outside of Intimidation or inhuman ways"] }
                ^"Rating 4" DEF { ^"Moral Guideline" STRING "Failing to kill when necessary" ^"Rationale" STRING "Nothing is more important than survival" ^"Effects" LIST OF STRING ["You suffer a two-dice penalty to interact with non-hostiles"] }
                ^"Rating 3" DEF { ^"Moral Guideline" STRING "Not defending your territory" ^"Rationale" STRING "Those who do not defend their territory have it taken from them" ^"Effects" LIST OF STRING ["You suffer a four-dice penalty to interact with non-hostiles"] }
                ^"Rating 2" DEF { ^"Moral Guideline" STRING "Showing your enemies mercy" ^"Rationale" STRING "Mercy is for the weak" ^"Effects" LIST OF STRING ["You suffer a six-dice penalty to interact with non-hostiles; Aura reduces the penalty to four"] }
                ^"Rating 1" DEF { ^"Moral Guideline" STRING "Failing to feed your hunger" ^"Rationale" STRING "The Beast must be satisfied" ^"Effects" LIST OF STRING ["You suffer an eight-dice penalty to interact with non-hostiles; Aura reduces this to five"] }
            }
        }
        DESCRIPTION "Followers of Via Bestiae control their Beast through the primal concepts of survival, strength, and individuality. Many choose a simple, animalistic existence to best serve its beliefs; others live simply, akin to barbarians."
    }

    # ============================================================
    #  Road of Humanity (Prodigals) — Via Humanitatis
    # ============================================================
    #wopRoadHumanity01 ^"Road of Humanity" DEF {
        EXTENDS ^"Road"
        PROPERTIES {
            ^"Latin Name" STRING "Via Humanitatis"
            ^"Followers" STRING "Prodigals"
            ^"Aura" STRING "Blush of Life"
            ^"Tenets" LIST OF STRING [
                "A man is measured by his words, his deeds and his heart, not an accident of birth or circumstance",
                "The ability to reason separates man from beast",
                "Do unto others as you would have them do unto you",
                "All men are brothers",
                "Freedom is earned with dignity and justice"
            ]
            ^"Hierarchy of Sins" DEF {
                ^"Rating 10" DEF { ^"Moral Guideline" STRING "Selfish thoughts" ^"Rationale" STRING "Thought is as good as deed" ^"Effects" LIST OF STRING ["Permanently have the effects of Aura; appear as a healthy human", "Heal Superficial damage as a mortal", "You can taste, eat, and digest food as if human", "You can stay awake during the day as if human", "The rate of sunlight damage you take is halved"] }
                ^"Rating 9" DEF { ^"Moral Guideline" STRING "Minor selfish acts" ^"Rationale" STRING "Compassion separates us from the beasts" ^"Effects" LIST OF STRING ["Permanently have the effects of Aura; appear as an ill human", "Heal Superficial damage as a mortal", "You can taste, eat, and digest rare or raw meat and many liquids", "You can rise from day-sleep up to an hour before sunset and stay awake an hour after dawn"] }
                ^"Rating 8" DEF { ^"Moral Guideline" STRING "Injury to another person (deliberate or otherwise)" ^"Rationale" STRING "Follow the golden rule" ^"Effects" LIST OF STRING ["Roll two dice for the Aura Rouse check and take the highest result", "Aura allows you to digest and taste wine", "You can rise from day-sleep up to an hour before sunset"] }
                ^"Rating 7" DEF { ^"Moral Guideline" STRING "Theft and robbery" ^"Rationale" STRING "Respect the property of others" ^"Effects" LIST OF STRING ["Unless using Aura, food and drink makes you immediately vomit unless a Composure + Stamina check is passed"] }
                ^"Rating 6" DEF { ^"Moral Guideline" STRING "Accidental killing" ^"Rationale" STRING "Ignorance does not excuse cruelty" ^"Effects" LIST OF STRING ["With Aura, make a check to keep food and drink down for an hour"] }
                ^"Rating 5" DEF { ^"Moral Guideline" STRING "Wanton destruction" ^"Rationale" STRING "Man creates; beast destroys" ^"Effects" LIST OF STRING ["You suffer a one-die penalty to interact with humans outside of Intimidation or inhuman ways"] }
                ^"Rating 4" DEF { ^"Moral Guideline" STRING "Impassioned killing" ^"Rationale" STRING "Those who act as beasts become beasts" ^"Effects" LIST OF STRING ["You suffer a two-dice penalty to interact with humans", "Can no longer keep food or drink down, even with Aura"] }
                ^"Rating 3" DEF { ^"Moral Guideline" STRING "Planned killing" ^"Rationale" STRING "If you surrender to the Beast, you become its slave" ^"Effects" LIST OF STRING ["You suffer a four-dice penalty to interact with humans"] }
                ^"Rating 2" DEF { ^"Moral Guideline" STRING "Casual killing" ^"Rationale" STRING "Others are worthy of respect" ^"Effects" LIST OF STRING ["You suffer a six-dice penalty to interact with humans; Aura reduces the penalty to four"] }
                ^"Rating 1" DEF { ^"Moral Guideline" STRING "The most heinous and demented acts" ^"Rationale" STRING "Are you man or beast?" ^"Effects" LIST OF STRING ["You suffer an eight-dice penalty to interact with humans; Aura reduces this to five"] }
            }
        }
        DESCRIPTION "Followers of Via Humanitatis use the human condition to fight their Beast, remembering the ordinary mortals they were before Caine's curse. They emphasize human virtues — freedom, the heart and soul, and reason as the separator of man from beast."
    }

    # ============================================================
    #  Road of Heaven (Faithful) — Via Caeli
    # ============================================================
    #wopRoadHeaven00001 ^"Road of Heaven" DEF {
        EXTENDS ^"Road"
        PROPERTIES {
            ^"Latin Name" STRING "Via Caeli"
            ^"Followers" STRING "Faithful"
            ^"Aura" STRING "Holy Radiance"
            ^"Tenets" LIST OF STRING [
                "God laid His mark upon Caine and his childer are part of His great plan",
                "The word of God is law. Defiance of God is a sin that leads to damnation",
                "No one is above God's law",
                "Love and serve God in all things",
                "Deny the Devil through denial of the Beast and all creatures of Hell"
            ]
            ^"Hierarchy of Sins" DEF {
                ^"Rating 10" DEF { ^"Moral Guideline" STRING "Violating any of the Ten Commandments" ^"Rationale" STRING "God's word is law" ^"Effects" LIST OF STRING ["Permanently have the effects of Aura; appear as a divine being", "Add 2 additional dice when resisting True Faith abilities"] }
                ^"Rating 9" DEF { ^"Moral Guideline" STRING "Failing to speak out against corruption and sin" ^"Rationale" STRING "All the Devil requires is for the faithful to do nothing" ^"Effects" LIST OF STRING ["Blush of Life hides your undead aura from supernatural detection by non-Cainites", "Add 1 additional die when resisting True Faith abilities"] }
                ^"Rating 8" DEF { ^"Moral Guideline" STRING "Acting out of pride, avarice, gluttony, or some other sinful impulse" ^"Rationale" STRING "Sin is the road to the Beast" ^"Effects" LIST OF STRING ["Roll two dice for the Aura Rouse check and take the highest result"] }
                ^"Rating 7" DEF { ^"Moral Guideline" STRING "Theft, robbery, willful vandalism" ^"Rationale" STRING "Thou shalt not steal" ^"Effects" LIST OF STRING ["With Aura, add 2 dice to checks made to hide your undead aura from supernatural detection by non-Cainites"] }
                ^"Rating 6" DEF { ^"Moral Guideline" STRING "Causing harm to pious and virtuous persons" ^"Rationale" STRING "God sees all and punishes such sins" ^"Effects" LIST OF STRING ["With Aura, add 1 die to checks made to hide your undead aura from supernatural detection by non-Cainites"] }
                ^"Rating 5" DEF { ^"Moral Guideline" STRING "Feeding from an innocent without permission" ^"Rationale" STRING "God protects the innocent" ^"Effects" LIST OF STRING ["You suffer a one-die penalty to interact with pious humans outside of Intimidation or inhuman ways"] }
                ^"Rating 4" DEF { ^"Moral Guideline" STRING "Blasphemous or heretical acts" ^"Rationale" STRING "Denial of God leads only to damnation" ^"Effects" LIST OF STRING ["You suffer a two-dice penalty to interact with pious humans"] }
                ^"Rating 3" DEF { ^"Moral Guideline" STRING "Allowing crime or major sin to go unpunished" ^"Rationale" STRING "Vengeance is mine, sayeth the Lord" ^"Effects" LIST OF STRING ["You suffer a four-dice penalty to interact with the pious"] }
                ^"Rating 2" DEF { ^"Moral Guideline" STRING "The murder of innocents" ^"Rationale" STRING "Thou shalt not kill" ^"Effects" LIST OF STRING ["You suffer a six-dice penalty to interact with the pious; Aura reduces the penalty to four"] }
                ^"Rating 1" DEF { ^"Moral Guideline" STRING "Aiding a demon or other supernatural agent of evil" ^"Rationale" STRING "Serve evil and you serve the Beast" ^"Effects" LIST OF STRING ["You suffer an eight-dice penalty to interact with the pious; Aura reduces this to five"] }
            }
        }
        DESCRIPTION "To follow the Road of Heaven is to love and serve God, obey His laws (the Ten Commandments being a prime example), and never act to empower the Devil. Other rules and gods may be substituted depending on the religion, but the general idea is the same."
    }

    # ============================================================
    #  Road of Kings (Scions) — Via Regalis
    # ============================================================
    #wopRoadKings000001 ^"Road of Kings" DEF {
        EXTENDS ^"Road"
        PROPERTIES {
            ^"Latin Name" STRING "Via Regalis"
            ^"Followers" STRING "Scions"
            ^"Aura" STRING "Air of Authority"
            ^"Tenets" LIST OF STRING [
                "There are only two roles in this world: that of master and that of servant",
                "You are superior to mortals, made to rule",
                "To master others, you must first master yourself and the Beast within",
                "Only those who seize power gain it; only those who use power keep it",
                "Your word is your bond. Without it, you are nothing"
            ]
            ^"Hierarchy of Sins" DEF {
                ^"Rating 10" DEF { ^"Moral Guideline" STRING "Neglecting your duty" ^"Rationale" STRING "Those who fail in their responsibilities often lose them" ^"Effects" LIST OF STRING ["Permanently have the effects of Aura; appear as an authority figure", "You may use your Mending ability to heal Superficial Willpower instead of physical damage once a night"] }
                ^"Rating 9" DEF { ^"Moral Guideline" STRING "Treating a peer with disrespect" ^"Rationale" STRING "A leader earns respect by acting respectfully" ^"Effects" LIST OF STRING ["Permanently have the effects of Blush of Life; appear as an important figure", "You heal your full Willpower rating in Superficial damage at the beginning of a session"] }
                ^"Rating 8" DEF { ^"Moral Guideline" STRING "Treating an inferior as an equal" ^"Rationale" STRING "Everyone should know their place, including you" ^"Effects" LIST OF STRING ["Roll two dice for the Aura Rouse check and take the highest result", "While your Aura is active, you may re-roll one additional die when spending Willpower to do so"] }
                ^"Rating 7" DEF { ^"Moral Guideline" STRING "Breaking your word to a peer" ^"Rationale" STRING "Trust is earned by being trustworthy" ^"Effects" LIST OF STRING ["While Aura is active, reduce any Superficial Willpower damage caused by Social Combat by two"] }
                ^"Rating 6" DEF { ^"Moral Guideline" STRING "Behaving shamefully before your peers" ^"Rationale" STRING "Honor and reputation are everything" ^"Effects" LIST OF STRING ["While Aura is active, reduce any Superficial Willpower damage caused by Social Combat by one"] }
                ^"Rating 5" DEF { ^"Moral Guideline" STRING "Showing weakness in front of your inferiors" ^"Rationale" STRING "A leader must be seen as strong" ^"Effects" LIST OF STRING ["You suffer a one-die penalty to interact with those of lower station"] }
                ^"Rating 4" DEF { ^"Moral Guideline" STRING "Failing to answer a challenge to your honor" ^"Rationale" STRING "Honor must be maintained; challenges cannot go unanswered" ^"Effects" LIST OF STRING ["You suffer a two-dice penalty to interact with those of lower station"] }
                ^"Rating 3" DEF { ^"Moral Guideline" STRING "Treating a superior with disrespect" ^"Rationale" STRING "Superiors must be given the respect they are due" ^"Effects" LIST OF STRING ["You suffer a four-dice penalty to interact with those of lower station"] }
                ^"Rating 2" DEF { ^"Moral Guideline" STRING "Breaking your word to your superiors" ^"Rationale" STRING "Your word is your bond; if your word is worthless, then so are you" ^"Effects" LIST OF STRING ["You suffer a six-dice penalty to interact with those of lower station; Aura reduces the penalty to four"] }
                ^"Rating 1" DEF { ^"Moral Guideline" STRING "Breaking a sworn oath" ^"Rationale" STRING "Oaths of fealty hold the world together" ^"Effects" LIST OF STRING ["You suffer an eight-dice penalty to interact with those of lower station; Aura reduces this to five"] }
            }
        }
        DESCRIPTION "Followers of Via Regalis control their Beast by ruling over others. Mortals are inferior, promises will be fulfilled, and power is everything."
    }
}
